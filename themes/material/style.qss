QWidget {
    color: #FFFFFF;
}

QLineEdit {
    border-radius: 20px;
    border: none;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgb(50, 36, 28);
}

QLineEdit:focus {
    border: 2px solid rgb(153, 109, 83);
}

QComboBox {
    margin-top: 20px;
    border-radius: 20px;
    border: none;
    background-color: rgb(50, 36, 28);
    padding-left: 10px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 40px;
    background-color: rgba(255, 255, 255, 0);
    border: none;
}

QComboBox::down-arrow {
    image: url(:/icons/arrow-down.png);
    width: 18px;
    height: 18px;
}

QComboBox::down-arrow:on { /* shift the arrow when popup is open */
    top: 1px;
    left: 1px;
}

QComboBox * {
    border-radius: 20px;
}

QComboBox QAbstractItemView {
    background-color: rgb(50, 36, 28);
}

QComboBox QListView {
    background-color: rgb(50, 36, 28);
    border-radius: 20px;
    border: none;
}

QComboBox * {
    background-color: rgb(50, 36, 28);
}

QToolButton#LoginButton {
    background-color: rgb(50, 36, 28);
    border-radius: 20px;
    margin-left: 10px;
}

QToolButton#LoginButton:hover {
    background-color: rgb(153, 109, 83);
}

QToolButton#LoginButton:pressed {
    background-color: #FFB68A;
}

QWidget#OverLay {
    background-color: rgb(50, 36, 28);
}
